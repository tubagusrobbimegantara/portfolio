---
interface Props { topic: string; }
const { topic } = Astro.props;
const kind = /economic|eoq/.test(topic) ? 'inventory' : /vehicle|vrp/.test(topic) ? 'routing' : 'transport';
---
<svg class={`topic-art topic-${kind}`} viewBox="0 0 480 240" aria-hidden="true" fill="none">
  {kind === 'inventory' ? <>
    <path fill="#efe1c8" d="M0 0h480v240H0z"/>
    <path d="M52 190h376M70 180V46" stroke="#a88454" stroke-width="2"/>
    <g fill="#c9a574" stroke="#80613a" stroke-width="2" shape-rendering="crispEdges">
      {[[106,142],[150,142],[194,142],[150,98],[194,98],[194,54],[292,142],[336,142],[336,98]].map(([x,y])=><g><rect x={x} y={y} width="36" height="36"/><path d={`M${x+14} ${y}h8v12h-8z`} fill="#f8ecd2" stroke="none"/></g>)}
    </g>
    <path d="M88 68h35v44h48v42h57M272 78h31v38h48v42h50" stroke="#7d3436" stroke-width="3" stroke-dasharray="5 4"/>
    <text x="28" y="220" fill="#80613a" font-family="system-ui" font-size="11" letter-spacing="2">SEDIKIT ATAU SEKALIGUS?</text>
  </> : kind === 'routing' ? <>
    <path fill="#ece6dd" d="M0 0h480v240H0z"/>
    <g stroke="#fffdf9" stroke-width="16"><path d="M0 68h480M0 164h480M110 0v240M255 0v240M395 0v240"/></g>
    <path d="M110 164V68h285v96H110" stroke="#a88454" stroke-width="5" stroke-dasharray="7 5"/>
    <path d="M110 164h145V68h140v96" stroke="#5d2021" stroke-width="5"/>
    {[[110,164],[255,68],[395,68],[395,164]].map(([x,y],i)=><g><rect x={x-13} y={y-13} width="26" height="26" rx="2" fill={i===0?'#5d2021':'#a88454'}/><text x={x} y={y+5} text-anchor="middle" font-family="system-ui" font-weight="700" font-size="14" fill="#fffdf9">{i===0?'G':i}</text></g>)}
    <text x="28" y="220" fill="#80613a" font-family="system-ui" font-size="11" letter-spacing="2">URUTAN MENGUBAH JARAK</text>
  </> : <>
    <path fill="#f1e4de" d="M0 0h480v240H0z"/>
    <g stroke="#b79674" stroke-width="2"><path d="M124 84h75l140-32M124 84h75l140 60M124 84h75l140 96M124 170h75L339 52M124 170h75l140-58M124 170h75l140 38"/></g>
    <path d="M124 84h75L339 52M124 170h75l140-58" stroke="#7d3436" stroke-width="4"/>
    <g fill="#5d2021" shape-rendering="crispEdges">{[60,146].map(y=><g><path d={`M64 ${y}h52v12h8v40H56v-40h8z`}/><path d={`M78 ${y+28}h24v24H78z`} fill="#c8a677"/></g>)}</g>
    <g shape-rendering="crispEdges">{[30,90,186].map(y=><g><path d={`M340 ${y}h45v34h-45z`} fill="#c8a677"/><path d={`M335 ${y-4}h55v10h-55z`} fill="#80613a"/><path d={`M356 ${y+15}h12v19h-12z`} fill="#fff0d4"/></g>)}</g>
    <text x="28" y="228" fill="#80613a" font-family="system-ui" font-size="11" letter-spacing="2">BARANG SAMPAI, ONGKOS TERKENDALI</text>
  </>}
</svg>
