---
const menu = [
	{ href: "/", label: "Beranda" },
	{ href: "/video", label: "Video Animasi" },
	{ href: "/materi", label: "Materi Matematika" },
	{ href: "/profil", label: "Profil Tubagus Robbi Megantara" },
];

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const aktif = (href: string) =>
	href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<nav id="nav">
	<div class="nav-in">
		<a href="/" class="brand" aria-label="Mathantara — beranda">
			<img src="/brand/mark.png" alt="" width="34" height="34" />
			<span class="brand-text">
				<span class="brand-name">MATHANTARA</span>
				<span class="brand-sub">Dari Masalah Menuju Wawasan</span>
			</span>
		</a>

		<ul class="nav-links" id="navLinks">
			{
				menu.map((m) => (
					<li>
						<a href={m.href} class:list={[{ active: aktif(m.href) }]}>
							{m.label}
						</a>
					</li>
				))
			}
		</ul>

		<div class="nav-r">
			<a href="/materi" class="btn btn-ghost btn-sm">Mulai belajar</a>
			<button class="hamburger" id="hbg" aria-label="Buka menu" aria-expanded="false" aria-controls="navLinks">
				<svg width="22" height="22" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
					<rect y="4" width="20" height="1.8" rx="0.9"></rect>
					<rect y="9.1" width="20" height="1.8" rx="0.9"></rect>
					<rect y="14.2" width="20" height="1.8" rx="0.9"></rect>
				</svg>
			</button>
		</div>
	</div>
</nav>
