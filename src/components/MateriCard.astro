---
import type { CollectionEntry } from "astro:content";
import PixelIcon from './PixelIcon.astro';

interface Props {
	materi: CollectionEntry<"materi">;
	adaVideo?: boolean;
}

const { materi, adaVideo = false } = Astro.props;
const d = materi.data;
const nomor = String(d.urutan).padStart(2, '0');
const simbol = materi.id.includes('economic') ? 'Q*' : materi.id.includes('vehicle') ? 'A → B' : 'Σ';
const menit = Math.max(1, Math.ceil((materi.body ?? '').split(/\s+/).length / 180));
---

<article class="mcard" data-kategori={d.kategori} data-search={`${d.judul} ${d.deskripsi} ${d.kategori} ${d.tag.join(' ')}`}>
	<div class="material-art" aria-hidden="true"><span class="material-number">CATATAN {nomor}</span><span class="material-formula">{simbol}</span><PixelIcon name="spark" size={24}/><span class="material-gridline"></span></div>
	<div class="material-body">
	<div class="mmeta">
		<span class="tagpill">{d.kategori}</span>
		<span class="read-time">{menit} menit baca</span>
	</div>
	<h3><a href={`/materi/${materi.id}`}>{d.judul}</a></h3>
	<p>{d.deskripsi}</p>
	<div class="mfoot">
		<a class="go" href={`/materi/${materi.id}`}>
			Baca materi
			<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
				<path d="M5 12h14M13 6l6 6-6 6" />
			</svg>
		</a>
		{
			adaVideo && (
				<span class="vlink">
					<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M8 5v14l11-7z" />
					</svg>
					ada videonya
				</span>
			)
		}
	</div>
	</div>
</article>
