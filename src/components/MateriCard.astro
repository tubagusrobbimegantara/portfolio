---
import type { CollectionEntry } from "astro:content";
import TopicArt from './TopicArt.astro';

interface Props {
	materi: CollectionEntry<"materi">;
	adaVideo?: boolean;
}

const { materi, adaVideo = false } = Astro.props;
const d = materi.data;
const menit = Math.max(1, Math.ceil((materi.body ?? '').split(/\s+/).length / 180));
---

<article class="mcard" data-kategori={d.kategori} data-search={`${d.judul} ${d.deskripsi} ${d.kategori} ${d.tag.join(' ')}`}>
	<div class="material-art"><TopicArt topic={materi.id} /></div>
	<div class="material-body">
	<p class="card-meta">{d.kategori} · ± {menit} menit baca</p>
	<h3><a href={`/materi/${materi.id}`}>{d.judul}</a></h3>
	<p>{d.deskripsi}</p>
	<div class="mfoot">
		<a class="go" href={`/materi/${materi.id}`}>
			Baca materi
			<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
				<path d="M5 12h14M13 6l6 6-6 6" />
			</svg>
		</a>
		{
			adaVideo && (
				<span class="vlink">
					<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
						<path d="M8 5v14l11-7z" />
					</svg>
					ada videonya
				</span>
			)
		}
	</div>
	</div>
</article>
