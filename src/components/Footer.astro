---
import { KANAL } from "../consts";
import { tautan } from "../data/profil";

const tahun = new Date().getFullYear();
const sosial = [
	{ nama: "YouTube", url: KANAL.youtube },
	{ nama: "TikTok", url: KANAL.tiktok },
	{ nama: "Instagram", url: KANAL.instagram },
].filter((s) => s.url);

const akademik = tautan.filter((t) => t.jenis === "akademik" || t.nama === "LinkedIn");
---

<footer>
	<div class="wrap">
		<div class="foot-grid">
			<div class="foot-brand">
				<img src="/brand/wordmark.png" alt="Mathantara" width="150" height="59" loading="lazy" />
				<p>
					Video animasi matematika dan materi lengkap dengan notasi LaTeX — dari
					masalah nyata menuju wawasan.
				</p>
			</div>

			<div class="foot-col">
				<h4>Jelajahi</h4>
				<a href="/video">Video Animasi</a>
				<a href="/materi">Materi Matematika</a>
				<a href="/profil">Profil Tubagus Robbi Megantara</a>
			</div>

			<div class="foot-col">
				<h4>{sosial.length ? "Ikuti & Tautan" : "Tautan"}</h4>
				{
					sosial.map((s) => (
						<a href={s.url} target="_blank" rel="noopener">
							{s.nama}
						</a>
					))
				}
				{
					akademik.map((t) => (
						<a href={t.url} target="_blank" rel="noopener">
							{t.nama}
						</a>
					))
				}
			</div>
		</div>

		<div class="foot-bar">
			<span>© {tahun} Mathantara · Tubagus Robbi Megantara</span>
			<span>Dari masalah menuju wawasan</span>
		</div>
	</div>
</footer>
