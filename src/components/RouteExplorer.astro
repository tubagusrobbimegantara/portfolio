---
const places = [
  { name: 'Gudang', x: 80, y: 184 },
  { name: 'Toko 1', x: 160, y: 64 },
  { name: 'Toko 2', x: 320, y: 104 },
  { name: 'Toko 3', x: 280, y: 224 },
];
const plans = [[0, 2, 1, 3, 0], [0, 1, 2, 3, 0], [0, 1, 3, 2, 0]].map((order, i) => ({
  label: `Rute ${i + 1}`,
  description: order.map(n => places[n].name).join(' → '),
  distance: order.slice(1).reduce((sum, n, index) => {
    const previous = places[order[index]];
    return sum + (Math.abs(places[n].x - previous.x) + Math.abs(places[n].y - previous.y)) / 40;
  }, 0),
  path: `M${places[order[0]].x} ${places[order[0]].y} ` + order.slice(1).map(n => `H${places[n].x}V${places[n].y}`).join(' '),
}));
---
<div class="route-explorer" data-route-demo data-routes={JSON.stringify(plans)}>
  <div class="route-heading"><span class="route-kicker">Coba & temukan</span></div>
  <h2>Satu kurir. Tiga tujuan.</h2>
  <p class="route-question">Urutan berbeda, jaraknya sama?</p>
  <div class="route-stage">
    <svg class="route-map" viewBox="0 0 400 280" role="img" aria-labelledby="route-map-title route-map-desc">
      <title id="route-map-title">Peta pengiriman dari gudang ke tiga toko</title>
      <desc id="route-map-desc">G adalah gudang, angka 1 sampai 3 adalah toko. Setiap ruas jalan sepanjang satu kilometer. Rute dimulai dan berakhir di gudang.</desc>
      <image href="/art/route-town.svg" width="400" height="280" />
      <path data-route-path d={plans[0].path} fill="none" stroke="#7d3436" stroke-width="4" stroke-linejoin="round" stroke-dasharray="7 5" />
      {places.map(place => <rect x={place.x - 4} y={place.y - 4} width="8" height="8" fill="#fffdf9" stroke="#5d2021" stroke-width="2" />)}
      <g font-family="Fredoka, sans-serif" font-size="18" font-weight="700" fill="#5d2021" text-anchor="middle">
        {[{label:'G',x:52,y:200},{label:'1',x:172,y:58},{label:'2',x:335,y:98},{label:'3',x:295,y:241}].map(({label,x,y}) => <g><rect x={x-9} y={y-16} width="22" height="22" rx="2" fill="#fffdf9" /><text x={x+2} y={y+1}>{label}</text></g>)}
      </g>
      <g transform="translate(80 184)" shape-rendering="crispEdges">
        <path d="M-13-8H5V-4h9V8h-27z" fill="#d69b3c" stroke="#fffdf9" stroke-width="1.5" />
        <path d="M6-3h5v5H6z" fill="#fffdf9" />
        <path d="M-10 5h6v6h-6zm16 0h6v6H6z" fill="#382c29" />
      </g>
    </svg>
    <video class="route-video" data-route-video hidden muted playsinline preload="none" aria-hidden="true" tabindex="-1"></video>
  </div>
  <p class="route-legend">G = gudang &middot; 1&ndash;3 = toko &middot; 1 ruas = 1 km</p>
  <div class="route-result" role="status" aria-live="polite" aria-atomic="true">
    <div><span data-route-label>{plans[0].label}</span><strong><span data-route-distance>{plans[0].distance}</span> <small>km</small></strong></div>
    <p data-route-description>{plans[0].description}</p>
    <p data-route-insight>Ini rute acuan. Coba urutan lain dan bandingkan jaraknya.</p>
  </div>
  <div class="route-controls">
    <button class="btn btn-solid btn-sm" type="button" data-route-next hidden>Coba rute lain <span aria-hidden="true">&#8635;</span></button>
    <button class="btn btn-ghost btn-sm" type="button" data-route-play hidden>Putar perjalanan</button>
  </div>
  <p class="route-playback-status" data-route-playback-status role="status" hidden></p>
  <a class="text-link" href="/materi/vehicle-routing-problem">Mengapa urutan berpengaruh? <span aria-hidden="true">&#8599;</span></a>
</div>
