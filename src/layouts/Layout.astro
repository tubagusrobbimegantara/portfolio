---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title: string;
	description?: string;
	image?: string;
	tipe?: "website" | "article";
}

const { title, description, image, tipe } = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title={title} description={description} image={image} tipe={tipe} />
	</head>
	<body>
		<canvas id="mathCanvas" aria-hidden="true"></canvas>
		<Header />
		<main class="page">
			<slot />
		</main>
		<Footer />
		<script src="/math-bg.js" is:inline></script>
		<script src="/site.js" is:inline></script>
	</body>
</html>
