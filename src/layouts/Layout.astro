---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
	title: string;
	description?: string;
	image?: string;
	tipe?: "website" | "article";
	/** Sembunyikan kaki halaman — dipakai beranda yang hanya satu layar. */
	polos?: boolean;
}

const { title, description, image, tipe, polos = false } = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title={title} description={description} image={image} tipe={tipe} />
		<noscript><link rel="stylesheet" href="/no-script.css" /></noscript>
	</head>
	<body>
		<a class="skip-link" href="#konten">Langsung ke konten</a>
		<Header />
		<main class="page" id="konten" tabindex="-1">
			<slot />
		</main>
		{!polos && <Footer />}
		<script src="/site.js" is:inline></script>
	</body>
</html>
