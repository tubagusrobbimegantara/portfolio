---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PixelIcon from '../components/PixelIcon.astro';
import RouteExplorer from '../components/RouteExplorer.astro';
import { SITE_DESCRIPTION } from '../consts';

const materi = (await getCollection('materi')).sort((a, b) => a.data.urutan - b.data.urutan);
const sorotan = materi[0];
---

<Layout title="Mathantara — Dari Masalah Menuju Wawasan" description={SITE_DESCRIPTION}>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <span class="hero-tag">MATEMATIKA, DEKAT DENGAN KESEHARIAN.</span>
        <h1>Dari masalah,<br />menuju <span class="hero-emphasis">wawasan.</span></h1>
        <p class="lede">Mengapa urutan pengiriman bisa mengubah ongkos? Kapan toko perlu memesan barang lagi? Di sini, pertanyaan sehari-hari menjadi pintu masuk untuk memahami matematika.</p>
        {sorotan && (
          <div class="hero-cta">
            <a class="btn btn-solid" href="#sorotan">Temukan satu persoalan <PixelIcon name="arrow" size={16} /></a>
          </div>
        )}
      </div>
      <RouteExplorer />
    </div>
  </section>

  {sorotan && (
    <section class="home-feature" id="sorotan" aria-labelledby="sorotan-title">
      <div class="wrap home-feature-grid">
        <div class="home-feature-intro">
          <span class="eyebrow">SATU PERSOALAN UNTUK DIPIKIRKAN</span>
          <h2>Bagaimana matematika<br />membantu kita memilih?</h2>
          <p>Mulai dari situasinya. Kenali yang bisa dihitung, lalu temukan alasan di balik sebuah keputusan.</p>
        </div>
        <article class="spotlight">
          <div class="spotlight-label"><PixelIcon name="book" size={18} /> {sorotan.data.kategori}</div>
          <h3 id="sorotan-title"><a href={`/materi/${sorotan.id}`}>{sorotan.data.judul}</a></h3>
          <p>{sorotan.data.deskripsi}</p>
          <a class="text-link" href={`/materi/${sorotan.id}`}>Telusuri persoalannya <PixelIcon name="arrow" size={15} /></a>
        </article>
      </div>
    </section>
  )}
</Layout>
