---
import Layout from '../layouts/Layout.astro';
import PixelIcon from '../components/PixelIcon.astro';
import { SITE_DESCRIPTION } from '../consts';
---

<Layout title="Mathantara — Dari Masalah Menuju Wawasan" description={SITE_DESCRIPTION} polos>
  <section class="panggung" data-logo-3d="/brand/mark.png">
    <div class="panggung-panel">
      <div class="panggung-objek">
        <canvas
          width="640"
          height="640"
          tabindex="0"
          role="img"
          aria-label="Logo Mathantara dalam bentuk balok tiga dimensi. Putar dengan menyeret, atau dengan tombol panah."
        ></canvas>
        <img class="panggung-cadangan" src="/brand/mark.png" alt="Logo Mathantara" width="348" height="316" />
      </div>

      <div class="panggung-tautan">
        <a class="pelampung pelampung-1" href="/video">
          <PixelIcon name="play" size={15} />
          Video
        </a>
        <a class="pelampung pelampung-2" href="/materi">
          <PixelIcon name="book" size={15} />
          Materi
        </a>
        <a class="pelampung pelampung-3" href="/profil">
          <PixelIcon name="person" size={15} />
          Tentang
        </a>
      </div>
    </div>

    <p class="panggung-petunjuk">
      <PixelIcon name="spark" size={14} />
      Seret logonya
    </p>

    <a class="btn btn-solid" href="/materi">
      Mulai belajar
      <PixelIcon name="arrow" size={16} />
    </a>
  </section>

  <script src="/logo-3d.js" is:inline></script>
</Layout>
