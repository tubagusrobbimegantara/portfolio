---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import MateriCard from '../../components/MateriCard.astro';
import PixelIcon from '../../components/PixelIcon.astro';
import { tautanUtama } from '../../lib/video';
const materi = (await getCollection('materi')).sort((a,b)=>a.data.urutan-b.data.urutan || b.data.tanggal.valueOf()-a.data.tanggal.valueOf());
const video = await getCollection('video');
const slugBervideo = new Set(video.filter(v=>tautanUtama(v.data)).map(v=>v.data.materi));
const kategori = [...new Set(materi.map(m=>m.data.kategori))].sort();
---
<Layout title="Materi Matematika — Mathantara" description="Jelajahi materi matematika, contoh soal, rumus, dan latihan. Cari topik yang ingin kamu pahami, lalu pelajari langkah demi langkah.">
  <section class="banner"><div class="wrap"><span class="eyebrow">Materi</span><h1 class="display lg">Ide besar.<br/><em>Mulai dari satu langkah.</em></h1><p class="lede">Pilih persoalan yang membuatmu penasaran. Kita mulai dari ceritanya, susun modelnya, lalu telusuri perhitungannya — lengkap dengan contoh dan latihan.</p></div></section>
  <section><div class="wrap" data-library="materi">
    <div class="search-tools"><label class="search-field"><PixelIcon name="search" size={18}/><input type="search" placeholder="Cari materi, topik, atau kata kunci…" aria-label="Cari materi" autocomplete="off" /></label><p class="result-count" data-count role="status" aria-live="polite">{materi.length} materi tersedia</p></div>
    {kategori.length > 1 && <div class="filter-bar" aria-label="Filter kategori"><button class="chip on" data-filter="semua" aria-pressed="true">Semua materi</button>{kategori.map(k=><button class="chip" data-filter={k} aria-pressed="false">{k}</button>)}</div>}
    <div class="materi-grid" id="daftarMateri">{materi.map(m=><MateriCard materi={m} adaVideo={slugBervideo.has(m.id)}/>)}</div>
    <div class="kosong" data-empty hidden><b>Belum menemukan yang kamu cari.</b><p>Coba kata kunci yang lebih singkat atau pilih kategori lain.</p><button type="button" class="btn btn-ghost btn-sm" data-reset style="margin-top:20px">Tampilkan semua materi</button></div>
    {!materi.length && <noscript><div class="kosong">Materi baru sedang disiapkan. Kembali lagi segera.</div></noscript>}
  </div></section>
</Layout>
