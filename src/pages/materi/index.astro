---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import MateriCard from "../../components/MateriCard.astro";

const materi = (await getCollection("materi")).sort(
	(a, b) => a.data.urutan - b.data.urutan || b.data.tanggal.valueOf() - a.data.tanggal.valueOf(),
);
const video = await getCollection("video");
const slugBervideo = new Set(video.map((v) => v.data.materi).filter(Boolean));

const kategori = [...new Set(materi.map((m) => m.data.kategori))].sort();
---

<Layout
	title="Materi Matematika — Mathantara"
	description="Materi matematika bernotasi LaTeX: definisi, model, langkah pengerjaan, contoh soal terselesaikan, dan latihan — terhubung dengan video animasinya."
>
	<section class="banner">
		<div class="wrap">
			<span class="eyebrow">02 — Materi Matematika</span>
			<h1 class="display lg">Perhitungan <em>selengkapnya</em></h1>
			<p class="lede">
				Video menjelaskan gagasannya dalam dua menit; halaman-halaman ini
				menuntaskan perhitungannya. Semua rumus ditulis dengan LaTeX dan setiap
				contoh soal diselesaikan langkah demi langkah, lengkap dengan latihan di
				bagian akhir.
			</p>
		</div>
	</section>

	<hr class="rule" />

	<section>
		<div class="wrap">
			{
				kategori.length > 1 && (
					<div class="filter-bar" id="filterMateri">
						<button class="chip on" data-filter="semua">
							Semua ({materi.length})
						</button>
						{kategori.map((k) => (
							<button class="chip" data-filter={k}>
								{k}
							</button>
						))}
					</div>
				)
			}

			{
				materi.length ? (
					<div class="materi-grid" id="daftarMateri">
						{materi.map((m) => (
							<MateriCard materi={m} adaVideo={slugBervideo.has(m.id)} />
						))}
					</div>
				) : (
					<div class="kosong">
						<b>Belum ada materi</b>
						Tambahkan berkas baru di <code>src/content/materi/</code>, satu berkas
						untuk satu materi.
					</div>
				)
			}
		</div>
	</section>
</Layout>

<script is:inline>
	(function () {
		var bar = document.getElementById("filterMateri");
		if (!bar) return;
		bar.addEventListener("click", function (e) {
			var btn = e.target.closest(".chip");
			if (!btn) return;
			var pilih = btn.dataset.filter;
			bar.querySelectorAll(".chip").forEach(function (c) {
				c.classList.toggle("on", c === btn);
			});
			document.querySelectorAll("#daftarMateri .mcard").forEach(function (kartu) {
				var cocok = pilih === "semua" || kartu.dataset.kategori === pilih;
				kartu.classList.toggle("hide", !cocok);
			});
		});
	})();
</script>
