---
import Layout from '../layouts/Layout.astro';
import PixelIcon from '../components/PixelIcon.astro';
---
<Layout title="Halaman tidak ditemukan — Mathantara" description="Halaman yang dicari tidak ada di Mathantara. Kembali ke beranda atau jelajahi materi matematika.">
  <section class="not-found"><div class="wrap">
    <span class="eyebrow">Sepertinya kita salah jalan</span>
    <div class="error-pixel" aria-hidden="true">404</div>
    <h1 class="display md">Petualangannya belum berakhir.</h1>
    <p class="lede">Halaman ini tidak ditemukan. Kembali ke titik awal atau temukan wawasan baru di kumpulan materi.</p>
    <div class="hero-cta"><a class="btn btn-solid" href="/">Kembali ke beranda <PixelIcon name="arrow" size={15}/></a><a class="btn btn-ghost" href="/materi">Jelajahi materi</a></div>
  </div></section>
</Layout>
