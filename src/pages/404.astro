---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Halaman tidak ditemukan — Mathantara" description="Halaman yang dicari tidak ada di Mathantara.">
	<section class="banner">
		<div class="wrap" style="text-align:center;padding:60px 0">
			<span class="eyebrow plain" style="justify-content:center">Galat 404</span>
			<h1 class="display lg" style="margin:16px 0">Halamannya <em>tidak ketemu</em></h1>
			<p class="lede" style="margin:0 auto 30px">
				Alamat yang dituju tidak ada — mungkin salah ketik, atau halamannya sudah
				dipindahkan.
			</p>
			<div class="hero-cta" style="justify-content:center">
				<a class="btn btn-solid" href="/">Kembali ke beranda</a>
				<a class="btn btn-ghost" href="/materi">Lihat materi</a>
			</div>
		</div>
	</section>
</Layout>
