---
import Layout from "../layouts/Layout.astro";
import {
	identitas,
	statistik,
	pendidikan,
	peran,
	bidangPenelitian,
	publikasi,
	temaTerpakai,
	publikasiDiperbarui,
	tautan,
} from "../data/profil";

const scholar = tautan.find((t) => t.nama === "Google Scholar")?.url ?? "#";

const tglPerbarui = new Date(publikasiDiperbarui).toLocaleDateString("id-ID", {
	day: "numeric",
	month: "long",
	year: "numeric",
});
---

<Layout
	title="Profil Tubagus Robbi Megantara — Mathantara"
	description="Rekam jejak akademik Tubagus Robbi Megantara: pendidikan, bidang penelitian, publikasi terindeks Scopus, serta tautan LinkedIn dan media sosial."
>
	<section class="banner">
		<div class="wrap">
			<span class="eyebrow">Profil</span>
			<h1 class="display lg">Tubagus Robbi <em>Megantara</em></h1>
			<p class="lede">{identitas.ringkas}</p>
		</div>
	</section>

	<section class="tight">
		<div class="wrap">
			<div class="profil-grid">
				<div class="bio">
					{identitas.bio.map((p) => <p>{p}</p>)}

					<div class="stats">
						{
							statistik.map((s) => (
								<div class="stat">
									<b>{s.angka}</b>
									<span>{s.label}</span>
								</div>
							))
						}
					</div>
				</div>

				<aside class="profil-card">
					<img class="avatar" src="/brand/avatar.png" alt="Mathantara" width="92" height="92" loading="lazy" />
					<div class="kv">
						<div class="k">Nama</div>
						<div class="v">{identitas.nama}, {identitas.gelar}</div>
						<div class="s">{identitas.peranSingkat}</div>
					</div>
					{
						peran.map((r) => (
							<div class="kv">
								<div class="k">{r.label}</div>
								<div class="v">{r.judul}</div>
								<div class="s">{r.tempat}</div>
							</div>
						))
					}
					<div class="kv">
						<div class="k">Lokasi</div>
						<div class="v">{identitas.lokasi}</div>
					</div>
					<div class="kv">
						<div class="k">Surel</div>
						<div class="v">
							<a href={`mailto:${identitas.email}`}>{identitas.email}</a>
						</div>
					</div>
				</aside>
			</div>
		</div>
	</section>

	<hr class="rule" />

	<section>
		<div class="wrap">
			<div class="sec-head">
				<div>
					<span class="eyebrow">Perjalanan akademik</span>
					<h2>Pendidikan</h2>
				</div>
			</div>
			<div class="timeline">
				{
					pendidikan.map((e) => (
						<div class:list={["tl-item", { now: e.berjalan }]}>
							{e.tahun && <div class="tl-year">{e.tahun}</div>}
							<h3>{e.gelar}</h3>
							<div class="tl-place">{e.tempat}</div>
							<p class="tl-note">{e.catatan}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<hr class="rule" />

	<section>
		<div class="wrap">
			<div class="sec-head">
				<div>
					<span class="eyebrow">Penelitian</span>
					<h2>Bidang yang digeluti</h2>
					<p>Empat tema yang saling bertaut, semuanya berpangkal pada optimisasi.</p>
				</div>
			</div>
			<div class="area-grid">
				{
					bidangPenelitian.map((b) => (
						<div class="area">
							<div class="num">{b.nomor}</div>
							<h3>{b.judul}</h3>
							<p>{b.isi}</p>
							<div class="tagrow">
								{b.tag.map((t) => (
									<span>{t}</span>
								))}
							</div>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<hr class="rule" />

	<section>
		<div class="wrap">
			<div class="sec-head">
				<div>
					<span class="eyebrow">Publikasi</span>
					<h2>
						{publikasi.length} <em>karya terpublikasi</em>
					</h2>
					<p>
						Diterbitkan di jurnal internasional dan prosiding konferensi, disusun
						menurut tema penelitian. Daftar ini ditarik otomatis dari OpenAlex dan
						ORCID; terakhir diperbarui {tglPerbarui}.
					</p>
				</div>
				<a class="btn btn-ghost btn-sm" href={scholar} target="_blank" rel="noopener">
					Google Scholar
				</a>
			</div>

			<div class="filter-bar" id="filterPub">
				<button class="chip on" data-filter="semua" aria-pressed="true">Semua ({publikasi.length})</button>
				{
					temaTerpakai.map((t) => (
						<button class="chip" data-filter={t.id} aria-pressed="false">
							{t.nama}
						</button>
					))
				}
			</div>

			<div id="daftarPub">
				{
					publikasi.map((p) => (
						<article class="pub" data-tema={p.tema}>
							<div class="pub-year">{p.tahun}</div>
							<div>
								<h3>
									{p.doi ? (
										<a href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener">
											{p.judul}
										</a>
									) : (
										p.judul
									)}
								</h3>
								<div class="pub-jurnal">
									<em>{p.jurnal}</em>
									{p.detail && <span> · {p.detail}</span>}
								</div>
								<div class="pub-penulis">
									{p.penulis.map((nama, i) => (
										<Fragment>
											{i > 0 && ", "}
											{nama.includes("Megantara") ? <b>{nama}</b> : nama}
										</Fragment>
									))}
								</div>
								<div class="pub-row">
									{p.label?.map((l) => <span class="pub-badge">{l}</span>)}
									{p.doi && (
										<a class="pub-doi" href={`https://doi.org/${p.doi}`} target="_blank" rel="noopener">
											<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
												<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
												<path d="M15 3h6v6M10 14 21 3" />
											</svg>
											{p.doi}
										</a>
									)}
								</div>
							</div>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<hr class="rule" />

	<section>
		<div class="wrap">
			<div class="sec-head">
				<div>
					<span class="eyebrow">Tautan</span>
					<h2>Terhubung</h2>
					<p>Terbuka untuk kolaborasi penelitian, pembimbingan, dan kerja sama pendidikan.</p>
				</div>
			</div>
			<div class="link-list">
				{
					tautan.map((t) => (
						<a class="link-row" href={t.url} target={t.url.startsWith("mailto:") ? undefined : "_blank"} rel="noopener">
							<span class="n">{t.nama}</span>
							<span class="v">{t.nilai}</span>
						</a>
					))
				}
			</div>
		</div>
	</section>

	<section class="tight">
		<div class="wrap">
			<div class="cta cta-stack">
				<h2>Mari <em>berkolaborasi</em></h2>
				<p>
					Punya persoalan nyata yang terasa perlu dimodelkan, atau ingin mengusulkan
					topik untuk video Mathantara berikutnya? Silakan berkirim surel.
				</p>
				<div class="hero-cta">
					<a class="btn btn-solid" href={`mailto:${identitas.email}`}>Kirim surel</a>
					<a class="btn btn-ghost" href="/materi">Lihat materi</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script is:inline>
	(function () {
		var bar = document.getElementById("filterPub");
		if (!bar) return;
		bar.addEventListener("click", function (e) {
			var btn = e.target.closest(".chip");
			if (!btn) return;
			var pilih = btn.dataset.filter;
			bar.querySelectorAll(".chip").forEach(function (c) {
				c.classList.toggle("on", c === btn);
				c.setAttribute("aria-pressed", String(c === btn));
			});
			document.querySelectorAll("#daftarPub .pub").forEach(function (kartu) {
				var cocok = pilih === "semua" || kartu.dataset.tema === pilih;
				kartu.classList.toggle("hide", !cocok);
			});
		});
	})();
</script>
