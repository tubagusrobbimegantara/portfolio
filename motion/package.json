{
  "name": "mathantara-route-motion",
  "version": "1.0.0",
  "description": "Reproducible pixel route animations for Mathantara",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "dependencies": {
    "@remotion/cli": "4.0.523",
    "@remotion/fonts": "4.0.523",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.523"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.523",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "remotion studio --no-open",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "remotion bundle",
    "prerender": "node scripts/prepare-assets.mjs",
    "render": "npm run render:1 && npm run render:2 && npm run render:3",
    "render:1": "remotion render src/index.ts Route1 ../public/motion/route-1.mp4 --codec=h264 --crf=23 --x264-preset=slow --pixel-format=yuv420p --muted --concurrency=2",
    "render:2": "remotion render src/index.ts Route2 ../public/motion/route-2.mp4 --codec=h264 --crf=23 --x264-preset=slow --pixel-format=yuv420p --muted --concurrency=2",
    "render:3": "remotion render src/index.ts Route3 ../public/motion/route-3.mp4 --codec=h264 --crf=23 --x264-preset=slow --pixel-format=yuv420p --muted --concurrency=2",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "test": "node --experimental-strip-types scripts/check-routes.mjs"
  }
}
